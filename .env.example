# AIHUBMIX_API_KEY: Required for the AI text generation API used by this app.
# Configure this in local .env.local and in Vercel project environment variables.
AIHUBMIX_API_KEY=YOUR_AIHUBMIX_API_KEY

# APP_URL: The URL where this applet is hosted.
# Set this to your deployed site URL when needed by links or callbacks.
APP_URL="MY_APP_URL"

# Local practice account password hashes: JSON mapping username to scrypt salt:hash.
# Configure actual salted hashes in .env.local; never use NEXT_PUBLIC_ for this value.
PRACTICE_PASSWORD_HASHES={}

# Server-only AI model and conservative daily caps (cache hits do not count).
AIHUBMIX_MODEL=gemini-3.1-flash-lite
AI_DAILY_USER_LIMIT=20
AI_DAILY_TOTAL_LIMIT=60
# Private files default to .practice-data/; back this folder up with the server.
# PRACTICE_DATA_DIR=/absolute/private/data/path

# Vercel shared storage (injected by the Upstash integration; never expose to browser)
# KV_REST_API_URL=https://your-database.upstash.io
# KV_REST_API_TOKEN=YOUR_REDIS_TOKEN
# PRACTICE_STORAGE_NAMESPACE=resumeai-pm:v1
